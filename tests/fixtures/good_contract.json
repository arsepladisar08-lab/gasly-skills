      "drive_upload": {
        "enabled": true,
        "visibility": "private"
      }
    }
  ],
  "actions": [
    {
      "name": "items.list",
      "min_role": "STAFF",
      "require_idem": false,
      "rate_limited": false,
      "public_lookup": false,
      "requires_high_entropy_token": false,
      "ui_bound": true
    }
  ]
