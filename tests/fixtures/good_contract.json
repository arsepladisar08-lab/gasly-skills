{
  "contract_version": "1.0.0",
  "kb_version": "2.1.0",
  "project": {
    "name": "FixtureApp",
    "surface_profile": "INTERNAL_APP",
    "access_profile": "P4",
    "regulatory_domain": "NONE"
  },
  "architecture": {
    "tier": "TIER_1_DECOUPLED_WORKSPACE",
